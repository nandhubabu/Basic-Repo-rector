# CodeNova AI Environment Configuration Template

# Google Gemini API Key (Required for default provider)
# Get a free key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Provider Configuration (gemini, ollama, groq)
RR_LLM_PROVIDER=gemini
RR_GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Configuration (Optional)
# GROQ_API_KEY=your_groq_api_key_here
# RR_GROQ_MODEL=llama3-8b-8192

# Ollama Local Configuration (Optional)
# RR_OLLAMA_MODEL=llama3

# Memory Configuration
RR_DB_PATH=repo_rector_memory.db
RR_CHROMA_PATH=./.repo_rector_chroma
RR_MAX_ITERATIONS=15
